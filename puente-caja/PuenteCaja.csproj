<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Las DLL heredadas de Banorte (PINPAD.TPV) suelen ser de 32 bits. Si la que entregue
         Banorte es de 64 bits, cambiar a x64 (y publicar con -r win-x64). Ver README. -->
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PuenteCaja</RootNamespace>
    <AssemblyName>PuenteCaja</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Puente de caja Titos</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="puente-caja.ejemplo.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
